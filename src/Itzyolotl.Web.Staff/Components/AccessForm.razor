<main class="mx-auto max-w-sm px-4 py-12">
    <h1 class="text-2xl font-black uppercase tracking-wide">
        Acceso del <span class="text-marca">personal</span>
    </h1>

    <p class="mt-2 text-sm text-texto-suave">Escribe la clave de acceso que te dio el administrador.</p>

    <form @onsubmit="SubmitAsync" class="mt-6 space-y-4">
        <input type="password"
               autocomplete="off"
               @bind="key"
               @bind:event="oninput"
               placeholder="Clave de acceso"
               class="w-full rounded-lg border border-borde bg-superficie px-3 py-3" />

        @if (Access.Message is not null)
        {
            <p class="rounded-xl border border-borde bg-superficie p-3 text-sm text-texto-suave">@Access.Message</p>
        }

        <button type="submit"
                disabled="@string.IsNullOrWhiteSpace(key)"
                class="w-full rounded-full bg-marca py-3 text-lg font-black uppercase text-black disabled:opacity-50">
            Entrar
        </button>
    </form>
</main>