@page "/menu"
<PageTitle>Menú · Itzyolotl</PageTitle>

<main class="mx-auto max-w-2xl px-4 pb-28 pt-8">
    <h1 class="text-3xl font-black uppercase tracking-wide">
        Nuestro <span class="text-marca">menú</span>
    </h1>

    @if (error is not null)
    {
        <p class="mt-6 rounded-xl border border-borde bg-superficie p-4 text-texto-suave">@error</p>
    }
    else if (menu is null)
    {
        <p class="mt-6 text-texto-suave">Cargando...</p>
    }
    else
    {
        @foreach (var category in menu.Categories)
        {
            <section class="mt-8">
                <h2 class="mb-3 text-sm font-bold uppercase tracking-widest text-marca">@category.Name</h2>

                <ul class="space-y-3">
                    @foreach (var product in category.Products)
                    {
                        var inCart = Cart.QuantityOf(product.Id);

                        <li class="rounded-2xl border border-borde bg-superficie p-4 @(product.IsAvailable ? "" : "opacity-50")">
                            <div class="flex items-baseline justify-between gap-4">
                                <span class="text-lg font-semibold">@product.Name</span>
                                <span class="font-bold text-marca">$@product.Price.ToString("0.00")</span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(product.Description))
                            {
                                <p class="mt-1 text-sm text-texto-suave">@product.Description</p>
                            }

                            @if (!product.IsAvailable)
                            {
                                <p class="mt-2 text-xs font-bold uppercase text-texto-suave">Agotado</p>
                            }
                            else
                            {
                                <div class="mt-3 flex items-center justify-end gap-3">
                                    @if (inCart > 0)
                                    {
                                        <span class="text-sm text-texto-suave">En tu carrito: @inCart</span>
                                    }

                                    <button type="button"
                                            @onclick="() => AddAsync(product)"
                                            class="rounded-full border border-marca px-4 py-1.5 text-sm font-bold uppercase text-marca">
                                        Agregar
                                    </button>
                                </div>
                            }
                        </li>
                    }
                </ul>
            </section>
        }
    }
</main>

@if (Cart.Count > 0)
{
    <a href="/carrito"
       class="fixed inset-x-4 bottom-4 mx-auto flex max-w-2xl items-center justify-between rounded-full bg-marca px-6 py-3 font-black uppercase text-black">
        <span>Ver carrito (@Cart.Count)</span>
        <span>$@Cart.Total.ToString("0.00")</span>
    </a>
}