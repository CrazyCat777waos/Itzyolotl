@page "/carrito"

<PageTitle>Carrito · Itzyolotl</PageTitle>

<main class="mx-auto max-w-2xl px-4 py-8">
    <h1 class="text-3xl font-black uppercase tracking-wide">
        Tu <span class="text-marca">carrito</span>
    </h1>

    @if (!loaded)
    {
        <p class="mt-6 text-texto-suave">Cargando...</p>
    }
    else if (Cart.Items.Count == 0)
    {
        <p class="mt-6 rounded-xl border border-borde bg-superficie p-4 text-texto-suave">Tu carrito está vacío.</p>

        <div class="mt-4 flex flex-wrap gap-3">
            <a href="/menu" class="rounded-full bg-marca px-6 py-2 font-black uppercase text-black">Ver menú</a>

            @if (Cart.LastOrderId is { } lastOrderId)
            {
                <a href="/pedido/@lastOrderId" class="rounded-full border border-borde px-6 py-2 font-bold uppercase">
                    Mi último pedido
                </a>
            }
        </div>
    }
    else
    {
        <ul class="mt-6 space-y-3">
            @foreach (var item in Cart.Items)
            {
                <li class="rounded-2xl border border-borde bg-superficie p-4">
                    <div class="flex items-baseline justify-between gap-4">
                        <span class="text-lg font-semibold">@item.Name</span>
                        <span class="font-bold text-marca">$@item.Subtotal.ToString("0.00")</span>
                    </div>

                    <p class="text-sm text-texto-suave">$@item.UnitPrice.ToString("0.00") c/u</p>

                    <input type="text"
                           maxlength="@OrderLimits.MaxNoteLength"
                           value="@item.Note"
                           placeholder="Nota (ej. muy dorada)"
                           @onchange="e => OnNoteChanged(item.ProductId, e)"
                           class="mt-3 w-full rounded-lg border border-borde bg-obsidiana px-3 py-2 text-sm" />

                    <div class="mt-3 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <button type="button"
                                    aria-label="Quitar una unidad"
                                    @onclick="() => Cart.SetQuantityAsync(item.ProductId, item.Quantity - 1)"
                                    class="h-8 w-8 rounded-full border border-borde font-bold">
                                −
                            </button>

                            <span class="w-6 text-center font-bold">@item.Quantity</span>

                            <button type="button"
                                    aria-label="Agregar una unidad"
                                    @onclick="() => Cart.SetQuantityAsync(item.ProductId, item.Quantity + 1)"
                                    class="h-8 w-8 rounded-full border border-borde font-bold">
                                +
                            </button>
                        </div>

                        <button type="button"
                                @onclick="() => Cart.SetQuantityAsync(item.ProductId, 0)"
                                class="text-sm text-texto-suave underline">
                            Quitar
                        </button>
                    </div>
                </li>
            }
        </ul>

        <section class="mt-8 space-y-4">
            <div>
                <label for="customerName" class="text-sm font-bold uppercase tracking-widest text-marca">Tu nombre</label>
                <input id="customerName"
                       type="text"
                       maxlength="@OrderLimits.MaxCustomerNameLength"
                       @bind="customerName"
                       @bind:event="oninput"
                       placeholder="¿A nombre de quién?"
                       class="mt-2 w-full rounded-lg border border-borde bg-superficie px-3 py-3" />
            </div>

            <div>
                <span class="text-sm font-bold uppercase tracking-widest text-marca">¿Dónde lo comes?</span>

                <div class="mt-2 grid grid-cols-2 gap-3">
                    <button type="button"
                            @onclick="() => serviceType = ServiceTypeDto.DineIn"
                            class="@OptionClass(ServiceTypeDto.DineIn)">
                        @SpanishText.ServiceTypeLabel(ServiceTypeDto.DineIn)
                    </button>

                    <button type="button"
                            @onclick="() => serviceType = ServiceTypeDto.TakeAway"
                            class="@OptionClass(ServiceTypeDto.TakeAway)">
                        @SpanishText.ServiceTypeLabel(ServiceTypeDto.TakeAway)
                    </button>
                </div>
            </div>
        </section>

        <div class="mt-6 flex items-baseline justify-between border-t border-borde pt-4">
            <span class="text-texto-suave">Total estimado</span>
            <span class="text-2xl font-black text-marca">$@Cart.Total.ToString("0.00")</span>
        </div>

        <p class="mt-1 text-xs text-texto-suave">El precio final se confirma al enviar el pedido.</p>

        @if (error is not null)
        {
            <p class="mt-4 rounded-xl border border-borde bg-superficie p-4 text-sm text-texto-suave">@error</p>
        }

        <button type="button"
                disabled="@sending"
                @onclick="SendAsync"
                class="mt-6 w-full rounded-full bg-marca py-3 text-lg font-black uppercase text-black disabled:opacity-50">
            @(sending ? "Enviando..." : "Enviar pedido")
        </button>
    }
</main>